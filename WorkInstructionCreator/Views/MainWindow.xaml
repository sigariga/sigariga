<Window x:Class="WorkInstructionCreator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkInstructionCreator.Views"
        mc:Ignorable="d"
        Title="Work Instruction Creator" 
        Height="900" 
        Width="1400"
        MinHeight="600"
        MinWidth="1000"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{DynamicResource MaterialDesignToolBarBackground}">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewDocumentCommand}" InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="FileOutline"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Open" Command="{Binding OpenDocumentCommand}" InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="FolderOpenOutline"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Save" Command="{Binding SaveDocumentCommand}" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="ContentSave"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Export to _PDF" Command="{Binding ExportToPdfCommand}">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="FilePdfBox"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Export to _Word" Command="{Binding ExportToWordCommand}">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="FileWordOutline"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding EditorViewModel.UndoCommand}" InputGestureText="Ctrl+Z">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="Undo"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Redo" Command="{Binding EditorViewModel.RedoCommand}" InputGestureText="Ctrl+Y">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="Redo"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Find & Replace" Command="{Binding EditorViewModel.FindReplaceCommand}" InputGestureText="Ctrl+H">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="FindReplace"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Insert">
                <MenuItem Header="_Table" Command="{Binding EditorViewModel.InsertTableCommand}">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="Table"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Safety Note" Command="{Binding EditorViewModel.InsertSafetyNoteCommand}">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="Alert"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Warning Note" Command="{Binding EditorViewModel.InsertWarningNoteCommand}">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="AlertCircle"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Procedure Step" Command="{Binding EditorViewModel.InsertProcedureStepCommand}">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="ClipboardList"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Checklist" Command="{Binding EditorViewModel.InsertChecklistCommand}">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="CheckboxMarkedCircle"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Check with AI Assistant" Command="{Binding CheckWithChatbotCommand}">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="Robot"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Get Suggestions" Command="{Binding GetChatbotSuggestionsCommand}">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="Lightbulb"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Preview Document" Command="{Binding PreviewDocumentCommand}">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="Eye"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1" Background="{DynamicResource MaterialDesignToolBarBackground}" ToolBarTray.IsLocked="True">
            <Button Command="{Binding NewDocumentCommand}" ToolTip="New Document (Ctrl+N)">
                <materialDesign:PackIcon Kind="FileOutline"/>
            </Button>
            <Button Command="{Binding OpenDocumentCommand}" ToolTip="Open Document (Ctrl+O)">
                <materialDesign:PackIcon Kind="FolderOpenOutline"/>
            </Button>
            <Button Command="{Binding SaveDocumentCommand}" ToolTip="Save Document (Ctrl+S)">
                <materialDesign:PackIcon Kind="ContentSave"/>
            </Button>
            <Separator/>
            <Button Command="{Binding ExportToPdfCommand}" ToolTip="Export to PDF">
                <materialDesign:PackIcon Kind="FilePdfBox"/>
            </Button>
            <Button Command="{Binding ExportToWordCommand}" ToolTip="Export to Word">
                <materialDesign:PackIcon Kind="FileWordOutline"/>
            </Button>
            <Separator/>
            <Button Command="{Binding CheckWithChatbotCommand}" ToolTip="Check with AI Assistant">
                <materialDesign:PackIcon Kind="Robot"/>
            </Button>
            <Button Command="{Binding ToggleChatbotCommand}" ToolTip="Toggle AI Assistant Panel">
                <materialDesign:PackIcon Kind="MessageProcessing"/>
            </Button>
            <Separator/>
            <Button Command="{Binding PreviewDocumentCommand}" ToolTip="Preview Document">
                <materialDesign:PackIcon Kind="Eye"/>
            </Button>
        </ToolBar>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="250"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Templates, Flowcharts, Content -->
            <materialDesign:Card Grid.Column="0" Margin="8,4,4,8" 
                               materialDesign:ShadowAssist.ShadowDepth="Depth2">
                <TabControl Style="{StaticResource MaterialDesignTabControl}">
                    <TabItem Header="Templates">
                        <TabItem.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocument" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Templates" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </TabItem.HeaderTemplate>
                        <views:TemplateSelectionView DataContext="{Binding TemplateSelectionViewModel}"/>
                    </TabItem>
                    
                    <TabItem Header="Flowcharts">
                        <TabItem.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FlowChart" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Flowcharts" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </TabItem.HeaderTemplate>
                        <views:FlowchartSelectionView DataContext="{Binding FlowchartViewModel}"/>
                    </TabItem>
                    
                    <TabItem Header="Content">
                        <TabItem.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LibraryBooks" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Content" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </TabItem.HeaderTemplate>
                        <views:ContentLibraryView DataContext="{Binding ContentLibraryViewModel}"/>
                    </TabItem>
                </TabControl>
            </materialDesign:Card>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource MaterialDesignDivider}" 
                         HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Center Panel - Editor -->
            <materialDesign:Card Grid.Column="2" Margin="4,4,4,8" 
                               materialDesign:ShadowAssist.ShadowDepth="Depth2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Document Header -->
                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesignToolBarBackground}" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBox Text="{Binding CurrentWorkInstruction.Title}" 
                                       Style="{StaticResource MaterialDesignFilledTextBox}"
                                       materialDesign:HintAssist.Hint="Document Title"
                                       FontSize="18" FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                                <TextBox Text="{Binding CurrentWorkInstruction.Description}" 
                                       Style="{StaticResource MaterialDesignFilledTextBox}"
                                       materialDesign:HintAssist.Hint="Document Description"
                                       MaxLines="2"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="{Binding CurrentWorkInstruction.Version, StringFormat='v{0}'}" 
                                         VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding CurrentWorkInstruction.LastModified, StringFormat='Modified: {0:MM/dd/yyyy HH:mm}'}" 
                                         VerticalAlignment="Center" FontSize="12" 
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Editor -->
                    <views:EditorView Grid.Row="1" DataContext="{Binding EditorViewModel}"/>
                </Grid>
            </materialDesign:Card>

            <!-- Splitter -->
            <GridSplitter Grid.Column="3" Width="4" Background="{DynamicResource MaterialDesignDivider}" 
                         HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Right Panel - AI Assistant -->
            <materialDesign:Card Grid.Column="4" Margin="4,4,8,8" 
                               materialDesign:ShadowAssist.ShadowDepth="Depth2"
                               Visibility="{Binding IsChatbotVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- AI Assistant Header -->
                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesignToolBarBackground}" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Robot" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="AI Assistant" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}"
                                  Command="{Binding ToggleChatbotCommand}" ToolTip="Close AI Assistant">
                                <materialDesign:PackIcon Kind="Close"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- AI Response -->
                    <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ChatbotResponse}" 
                                 TextWrapping="Wrap" 
                                 FontFamily="Consolas"
                                 Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                 Padding="12"
                                 BorderBrush="{DynamicResource MaterialDesignDivider}"
                                 BorderThickness="1"/>
                    </ScrollViewer>

                    <!-- AI Actions -->
                    <StackPanel Grid.Row="2" Margin="16" Spacing="8">
                        <Button Command="{Binding CheckWithChatbotCommand}" 
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="Check Content" 
                              IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                        <Button Command="{Binding GetChatbotSuggestionsCommand}" 
                              Style="{StaticResource MaterialDesignOutlinedButton}"
                              Content="Get Suggestions"
                              IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="{DynamicResource MaterialDesignToolBarBackground}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" 
                               Width="120" Height="6"
                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CurrentWorkInstruction.Author, StringFormat='Author: {0}'}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>